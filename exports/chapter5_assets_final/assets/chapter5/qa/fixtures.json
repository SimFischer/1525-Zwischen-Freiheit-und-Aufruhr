  "texts": {
    "theological_arguments_table": [
      [
        "Obrigkeit gehorchen",
        "Ordnung schützt Menschen. Prüfe, ob Gehorsam hier andere schützt oder Unrecht fortsetzt."
      ],
      [
        "Gott mehr gehorchen",
        "Das Gewissen bindet. Begründe, wann ein Befehl verletzt, was du vor Gott verantwortest."
      ],
      [
        "Nächstenliebe und Widerstand",
        "Wem hilft dein Handeln? Denke auch an Menschen, die deine Überzeugung nicht teilen."
      ],
      [
        "Gottes Wille und eigener Wille",
        "Prüfe deine Auslegung: Was spricht dagegen, deinen politischen Wunsch heilig zu nennen?"
      ]
    ],
    "luther_four_thoughts": [
      [
        "Freiheit vor Gott",
        "Glaube befreit vom Zwang, sich durch Werke vor Gott rechtfertigen zu müssen."
      ],
      [
        "Dienst am Nächsten",
        "Freiheit wird im Dienst konkret. Auch Gegner bleiben Menschen, denen du verpflichtet bist."
      ],
      [
        "Weltliche Ordnung",
        "Äußere Ordnung soll schützen. Prüfe, wo Herrschaft selbst Unrecht hervorbringt."
      ],
      [
        "Kritik des Aufruhrs",
        "Eine berechtigte Forderung heiligt nicht jedes Mittel. Wer trägt die Folgen der Gewalt?"
      ]
    ],
    "three_reports": [
      [
        "Ein Bauer berichtet",
        "Wir wollten den Wagen aufhalten. Dann standen Bewaffnete vor uns. Ich sah einen Mann stürzen, aber nicht, wer den ersten Schlag führte. Manche sagen, wir hätten angegriffen; andere sprechen von einer Drohung. Ich weiß nur, dass jemand Hilfe braucht."
      ],
      [
        "Ein Amtsbote berichtet",
        "Ich sollte Abgaben und eine Nachricht überbringen. Am Weg standen Bauern. Sie wollten nicht weitergehen lassen. Als andere hinzukamen, wurde es unübersichtlich. Ob sie alle dieselbe Absicht hatten, kann ich nicht sagen. Meine Nachricht ist noch nicht zugestellt."
      ],
      [
        "Eine Zeugin berichtet",
        "Ich hörte Rufe und sah Menschen auseinanderlaufen. Später wurde ein Verletzter gestützt zurückgebracht. Über den Anfang des Zusammenstoßes erzählen die Leute Verschiedenes. Bevor ihr jemanden verurteilt, fragt, was er selbst gesehen hat und was er nur gehört hat."
      ]
    ],
    "religion_functions": [
      [
        "Hoffnung",
        "Glaube kann tragen, wenn Ausgänge ungewiss bleiben."
      ],
      [
        "Unrecht kritisieren",
        "Religiöse Maßstäbe können Herrschaft in Frage stellen."
      ],
      [
        "Gemeinschaft",
        "Gemeinsame Überzeugung verbindet Menschen und verpflichtet."
      ],
      [
        "Widerstand begründen",
        "Glaube kann zum Widerspruch gegen einen Befehl führen."
      ],
      [
        "Gewalt begrenzen",
        "Nächstenliebe verlangt, auch den Gegner zu schützen."
      ],
      [
        "Gewalt legitimieren",
        "Das Risiko: Der eigene Kampf erscheint als Gottes Wille."
      ]
    ]
  },
